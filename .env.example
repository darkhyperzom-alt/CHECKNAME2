# ----- Telegram -----
# ไปสร้าง API ID/Hash ได้ที่ https://my.telegram.org
TG_API_ID=
TG_API_HASH=
# สร้างด้วย generate_session.py (รันครั้งเดียวตอน setup)
TG_SESSION=
# ID ของกลุ่มที่บอทติดตามกิจกรรม (กินข้าว/พักเบรก ฯลฯ)
TG_GROUP_ID=
# ID ของกลุ่มเช็คชื่อ
TG_GROUP_ID_CHECKIN=

# ----- ฐานข้อมูล -----
DATABASE_URL=postgresql://user:password@host:5432/dbname
DB_POOL_MAX=8

# ----- แดชบอร์ด -----
# เว้นว่าง DASH_USER ไว้ = เข้าแดชบอร์ดได้โดยไม่ต้องล็อกอิน
DASH_USER=
DASH_PASS=
# โดเมนที่อนุญาตให้เรียก API ข้าม origin (คั่นด้วย , ถ้ามีหลายโดเมน) เว้นว่าง = ปิด CORS
CORS_ORIGINS=
# รหัสแอดมินสำหรับแก้ไข/ลบข้อมูลในหน้าตารางกะรายเดือน (ดูตารางได้ปกติ แต่แก้ไขต้องใส่รหัสนี้)
# เว้นว่าง = เปิดให้แก้ไขได้เลยไม่ต้องใส่รหัส
SHIFT_ADMIN_CODE=

# ----- พฤติกรรมทั่วไป -----
# จำนวนวันที่ไม่มีความเคลื่อนไหวแล้วซ่อนออกจากแดชบอร์ด
ACTIVE_DAYS=14
# รอบสูงสุด (วินาที) ระหว่างการ refresh cache ตารางกะ
SNAPSHOT_INTERVAL=2
# ปุ่มกิจกรรมที่บอทมี คั่นด้วย ,
ACTIVITIES=กินข้าว,ปวดหนัก,ปวดน้อย
# หมวดหมู่พนักงานตามคำนำหน้า username คั่นด้วย , (เช่น OD ครอบคลุมทั้ง OD-x และ ODOL-x)
CATEGORIES=OD,FT,AM
# 1 = นับเฉพาะข้อความที่แนบรูปในกลุ่มเช็คชื่อ
CHECKIN_REQUIRE_PHOTO=
# ข้อความยาวเกินนี้ในกลุ่มเช็คชื่อ ถือว่าเป็นการคุย ไม่ใช่เช็คชื่อ
CHECKIN_MAX_LEN=200
# 1 = log ข้อความดิบของทุกกลุ่ม (ใช้หาสาเหตุตอน debug แล้วปิดกลับ)
DEBUG_RAW=

# ----- เซิร์ฟเวอร์ -----
PORT=5000
